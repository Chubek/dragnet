@PACKAGE_INIT@
if(@MLVM_HAS_OPTILISP@)
  include(CMakeFindDependencyMacro)
  find_dependency(Threads)
endif()
if(@MLVM_SYSTEM_TREE_SITTER@ AND @MLVM_ENABLE_CEPHYR@)
  include(CMakeFindDependencyMacro)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(MLVMTreeSitter)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MLVMTargets.cmake")
check_required_components(MLVM)
